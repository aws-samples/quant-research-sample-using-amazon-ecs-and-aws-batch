{
  "availability_zone": {
    "name": "us-east-1a",
    "id": "use1-az4"
  },
  "app_with_codepipeline": false,
  "app_with_fsx": false,
  "app_with_s3express": false,
  "app_with_earnings_research": false,
  "app_with_gpu_fleet": false,
  "batch": {
    "deployment_type": "ALL",
    "single_node": {
      "maxv_cpus": 50,
      "minv_cpus": 0,
      "num_queues": 1,
      "container_cpu": 8,
      "container_memory": 16384,
      "container_command": [
        "python3",
        "main.py"
      ],
      "instance_classes": [
        "C6I", "C7A", "C7I", "R5", "R5A", "R5B", "R5D", "R5N", "R6A", "R6I", "R7I"
      ],
      "allocation_strategy": "BEST_FIT_PROGRESSIVE",
      "spot": false
    },
    "multi_node": {
      "maxv_cpus": 100,
      "minv_cpus": 0,
      "main": {
        "start_node_index": 0,
        "end_node_index": 0,
        "container_cpu": 32,
        "container_gpu": 4,
        "container_memory": 65536,
        "container_command": [
          "python3",
          "main.py"
        ]
      },
      "worker": {
        "start_node_index": 1,
        "end_node_index": 2,
        "container_cpu": 32,
        "container_gpu": 4,
        "container_memory": 65536,
        "container_command": [
          "python3",
          "main.py"
        ]
      },
      "instance_classes": [
        "G5",
        "C5"
      ],
      "allocation_strategy": "BEST_FIT_PROGRESSIVE",
      "spot": true
    },
    "queues": [
      {
        "id": "cpu",
        "name": "earnings-research-cpu",
        "maxv_cpus": 256,
        "instance_classes": ["C7I", "C7A", "M7I", "M7A", "R7I"],
        "spot": true,
        "egress": true
      },
      {
        "id": "capped",
        "name": "earnings-research-capped",
        "maxv_cpus": 24,
        "instance_classes": ["C7I", "M7I"],
        "spot": true,
        "egress": true
      }
    ]
  },
  "fsx": {
    "per_unit_storage_throughput": 200,
    "storage_capacity_gib": 1200,
    "deployment_type": "SCRATCH_2"
  },
  "s3": {
    "object_expiration_in_days": 1,
    "custom_arns": [
      "arn:aws:s3:::amzn-s3-demo-bucket/",
      "arn:aws:s3:::amzn-s3-demo-bucket1/"
    ]
  },
  "image_builds": [],
  "register_github_credentials": true,
  "gpu_fleet": {
    "_doc": "GPU fine-tuning fleet (infrastructure/gpu_fleet). The catalogue of GPU types, launch templates, disks and images is fixed in gpu_fleet/catalogue.py; a preset only selects families, types and regions. Every P-family queue is spot. Refresh where types are sold with gpu_fleet/refresh_offerings.py.",
    "preset": "open-weight-fine-tuning",
    "presets": {
      "open-weight-fine-tuning": {
        "_doc": "Recommended for fine-tuning open-weight models: every region that sells H100/H200/B200/B300/A100 and L4/L40S, spot only. 8-GPU spot capacity is per AZ and moves between regions by the hour; racing all of them is what makes a whole node obtainable, so the recommendation is all 18.",
        "regions": [
          "us-east-1", "us-east-2", "us-west-1", "us-west-2",
          "ca-central-1", "sa-east-1",
          "eu-north-1", "eu-central-1", "eu-west-1", "eu-west-2", "eu-west-3",
          "ap-northeast-1", "ap-northeast-2", "ap-northeast-3",
          "ap-south-1", "ap-southeast-1", "ap-southeast-2", "ap-southeast-3"
        ],
        "families": ["h100", "h200", "b200", "b300", "a100", "l4", "l40s"],
        "instance_types": [],
        "raw_ec2": true,
        "bench_job_definitions": true,
        "training_job_definitions": true
      }
    },
    "name_prefix": "rt",
    "vpc_cidr": "10.64.0.0/16",
    "nat_az_id": {},
    "no_egress_regions": [],
    "exclude_az_ids": {},
    "queue_priority": 100,
    "max_node_hours": 24,
    "weight_replica_bucket_prefix": "amzn-s3-demo-bucket-weights",
    "ecr_replication": true,
    "repository_prefix": "gpu-train-",
    "image_builds": [
      {
        "id": "gpu-train-hopper",
        "arch": "hopper",
        "repository": "gpu-train-hopper",
        "dockerfile": "samples/earnings_research/response_training/Dockerfile.train",
        "context": "samples/earnings_research",
        "branch": "main",
        "include_paths": ["samples/earnings_research/response_training/"],
        "exclude_paths": [],
        "compute_type": "LARGE",
        "timeout_minutes": 90
      },
      {
        "id": "gpu-train-blackwell",
        "arch": "blackwell",
        "repository": "gpu-train-blackwell",
        "dockerfile": "samples/earnings_research/response_training/Dockerfile.train",
        "context": "samples/earnings_research",
        "branch": "main",
        "include_paths": ["samples/earnings_research/response_training/"],
        "exclude_paths": [],
        "build_args": [
          "BASE_DEVEL=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-devel",
          "BASE_RUNTIME=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime",
          "TORCH_SERIES=2.8",
          "CUDA_ARCHS=9.0;10.0"
        ],
        "compute_type": "LARGE",
        "timeout_minutes": 90
      }
    ]
  },
  "earnings_research": {
    "nat_gateways": 1,
    "job_definition_name": "earnings-research",
    "secret_names": ["example-redshift-secret", "example-vendor-secret-1", "example-vendor-secret-2"],
    "bedrock_model_patterns": ["anthropic.*"],
    "container_cpu": 1,
    "container_memory": 4096,
    "image_build": {
      "id": "earnings-research",
      "repository": "earnings-research",
      "dockerfile": "samples/earnings_research/Dockerfile",
      "context": "samples/earnings_research",
      "branch": "main",
      "include_paths": ["samples/earnings_research/"],
      "exclude_paths": ["samples/earnings_research/mcp/", "samples/earnings_research/.claude/"]
    }
  }
}