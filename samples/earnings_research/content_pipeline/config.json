{
  "job_name": "er-full",
  "aws": {
    "region": "us-east-1",
    "profile": null
  },
  "s3": {
    "bucket": null,
    "prefix": "earnings-content"
  },
  "redshift": {
    "workgroup": null,
    "database": "dev",
