{
  "_doc": "Single config for the basket study: evaluation (panel source) AND aggregation (cap, chart scopes). Adding an index filter = add an entry to index_scopes and (if needed) its S3 prefix to index_prefixes. No code changes.",

  "evaluation": {
    "panel_sources": {
      "alpaca": "earnings-market-data/ALPACA.SIP/panels/",
      "databento": "earnings-market-data/XNAS.BASIC/panels/"
    },
    "default_source": "databento"
  },

  "aggregation": {
    "max_basket_weight": 0.02,

    "index_prefixes": {
      "NDX": "nasdaq-constituents/",
      "SPX": "sp500-constituents/",
      "RUI": "russell-1000-constituents/",
      "RUT": "russell-2000-constituents/",
      "RUA": "russell-3000-constituents/",
      "SPTM": "etf-constituents/fund=SPTM/",
      "XLC": "etf-constituents/fund=XLC/",
      "XLY": "etf-constituents/fund=XLY/",
      "XLP": "etf-constituents/fund=XLP/",
      "XLE": "etf-constituents/fund=XLE/",
      "XLF": "etf-constituents/fund=XLF/",
      "XLV": "etf-constituents/fund=XLV/",
      "XLI": "etf-constituents/fund=XLI/",
      "XLB": "etf-constituents/fund=XLB/",
      "XLRE": "etf-constituents/fund=XLRE/",
      "XLK": "etf-constituents/fund=XLK/",
      "XLU": "etf-constituents/fund=XLU/"
    },

    "_doc_scopes": "Ordered lists. tier scopes filter liquidity_tier; index scopes filter reporter membership (list = OR/union). exit_matrix_rows draw top-to-bottom; cell_matrices each produce cell_matrix_<key>.png.",

    "exit_matrix_rows": [
      {"key": "micro",     "label": "MICRO",     "tiers": ["micro"]},
      {"key": "small",     "label": "SMALL",     "tiers": ["small"]},
