      {"key": "midlarge",  "label": "MID+LARGE", "tiers": ["mid", "large"]},
      {"key": "ndx",       "label": "NDX",       "indices": ["NDX"]},
      {"key": "spx",       "label": "SPX",       "indices": ["SPX"]},
      {"key": "ndxspx",    "label": "NDX+SPX",   "indices": ["NDX", "SPX"]},
